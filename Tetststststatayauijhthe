local FALLBACK_VALUES = {
    ["Chroma"] = 1000, ["Chroma Darkbringer"] = 1000, ["Chroma Lightbringer"] = 1000,
    ["Chroma Heat"] = 1000, ["Chroma Luger"] = 1000, ["Chroma Slasher"] = 1000,
