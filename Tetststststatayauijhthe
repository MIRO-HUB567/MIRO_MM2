    while #items > 0 do
        local status = get_trade_status()
        if status == "None" then
            pcall(function() TradeService.SendRequest:InvokeServer(receiver) end)
            task.wait(0.5)
        elseif status == "ReceivingRequest" then
            pcall(function() TradeService.DeclineRequest:FireServer() end)
            task.wait(0.2)
