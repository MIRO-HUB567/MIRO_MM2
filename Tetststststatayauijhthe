-- SCAN INVENTORY — ORIGINAL FULL CODE
-- =============================================
local SKIP_ITEMS = {DefaultGun = true, DefaultKnife = true}
local function get_inventory()
    local items = {}
    local success, profile = pcall(function()
        return ReplicatedStorage.Remotes.Inventory.GetProfileData:InvokeServer(LocalPlayer.Name)
    end)
    if not success or not profile or not profile.Weapons then return items end
    for id, amount in pairs(profile.Weapons.Owned or {}) do
        if SKIP_ITEMS[id] then continue end
        local name = id
        local rarity = "Godly"
        local DB = ReplicatedStorage:FindFirstChild("Database") and ReplicatedStorage.Database:FindFirstChild("Sync") and ReplicatedStorage.Database.Sync:FindFirstChild("Item")
        if DB and DB[id] then name = DB[id].ItemName or id rarity = DB[id].Rarity or "Godly" end
        local value = get_item_price(name)
        table.insert(items, {id = id, name = name, amount = amount, rarity = rarity, value = value})
    end
    table.sort(items, function(a,b) return a.value > b.value end)
    return items
end

