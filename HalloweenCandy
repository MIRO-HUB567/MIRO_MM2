local function GetParts()
    local Char = LocalPlayer.Character
    if Char then
        local Root = Char:FindFirstChild("HumanoidRootPart"); local Hum = Char:FindFirstChild("Humanoid")
        if Root and Hum and Hum.Health > 0 then return Root, Hum end
    end
    return nil, nil
end

local function GetMap()
    for _, Obj in ipairs(workspace:GetChildren()) do
        if Obj:GetAttribute("MapID") or Obj.Name:lower():find("map") then
            return Obj
        end
    end
    return nil
end

local function GetNearestCandy(Root)
    local Map = GetMap()
    if not Root or not Map then return nil end
    
    local Closest, Dist = nil, math.huge
    local CoinContainer = Map:FindFirstChild("CoinContainer")
    
    if CoinContainer then
        for _, Coin in ipairs(CoinContainer:GetChildren()) do
            if Coin:IsA("BasePart") and not IgnoredCandies[Coin] then
                local D = (Root.Position - Coin.Position).Magnitude
                if D < Dist then Closest = Coin; Dist = D end
            end
        end
    else
        for _, v in ipairs(Map:GetDescendants()) do
            if v:IsA("BasePart") and not IgnoredCandies[v] then
                local n = v.Name:lower()
                if n:find("candy") or n:find("coin") then
                    local D = (Root.Position - v.Position).Magnitude
                    if D < Dist then Closest = v; Dist = D end
                end
            end
        end
    end
    return Closest
end

-- DETECT MURDERER
local function GetMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local roleAttr = player:GetAttribute("Role") or player:GetAttribute("Team")
                if roleAttr and (roleAttr == "Murderer" or roleAttr == "Murder") then
                    return player
                end
                
                for _, tool in ipairs(player.Character:GetChildren()) do
                    if tool:IsA("Tool") and (tool.Name:lower():find("knife") or tool.Name:lower():find("murder")) then
                        return player
                    end
                end
                
                if player:FindFirstChild("Backpack") then
                    for _, tool in ipairs(player.Backpack:GetChildren()) do
                        if tool:IsA("Tool") and (tool.Name:lower():find("knife") or tool.Name:lower():find("murder")) then
                            return player
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- ESP HIGHLIGHT LOGIC
local function UpdateESP(murdererPlayer)
    if not MurdererESPEnabled then
        if currentMurdererHighlight then
            currentMurdererHighlight:Destroy()
            currentMurdererHighlight = nil
        end
        return
    end
    
    if murdererPlayer and murdererPlayer.Character then
        if currentMurdererHighlight and currentMurdererHighlight.Adornee == murdererPlayer.Character then
            return
        end
        
        if currentMurdererHighlight then currentMurdererHighlight:Destroy() end
        currentMurdererHighlight = Instance.new("Highlight")
        currentMurdererHighlight.Name = "MurdererHighlight"
        currentMurdererHighlight.Adornee = murdererPlayer.Character
        currentMurdererHighlight.FillColor = Color3.fromRGB(255, 0, 0)
        currentMurdererHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        currentMurdererHighlight.FillTransparency = 0.5
        currentMurdererHighlight.OutlineTransparency = 0
        currentMurdererHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        currentMurdererHighlight.Parent = murdererPlayer.Character
    else
        if currentMurdererHighlight then
            currentMurdererHighlight:Destroy()
            currentMurdererHighlight = nil
        end
    end
end

function StartFarming()
    if FarmingThread then return end
    CandyCollected = 0; StartTime = os.time(); CandyLabel.Text = "Candy Collected: 0"; RateLabel.Text = "Est. Candy/Hour: 0"; RateLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    
    task.spawn(function()
        while IsFarming do
            local Elapsed = os.time() - StartTime
            TimeLabel.Text = "Time Active: " .. string.format("%02d:%02d", math.floor(Elapsed/60), Elapsed%60)
            task.wait(1)
        end
    end)

    FarmingThread = task.spawn(function()
        while IsFarming do
            pcall(function()
                while IsFarming do
                    local Root, Hum = GetParts()
                    
                    if not Root or not Hum then
                        UpdateESP(nil) 
                        RateLabel.Text = "Dead - Waiting for respawn..."
                        RateLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                        task.wait(1)
                        continue
                    end
                    
                    -- Hide Nametag
                    if not OriginalNameDisplay then
                        OriginalNameDisplay = Hum.DisplayDistanceType
                    end
                    Hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                    Hum.PlatformStand = true
                    
                    -- Disable Collisions to go underground
                    for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            CollisionCache[part] = true
                            part.CanCollide = false
                        end
                    end
                    
                    local murdererPlayer = GetMurderer()
                    UpdateESP(murdererPlayer)
                    
                    local Target = GetNearestCandy(Root)
                    if Target then
                        local D = (Root.Position - Target.Position).Magnitude
                        
                        if D < 1000 then
                            IgnoredCandies[Target] = true
                            task.delay(5, function() IgnoredCandies[Target] = nil end)
                            
                            Hum:ChangeState(11)
                            
                            -- Target 3.5 studs below the candy to stay underground
                            local targetPos = Target.Position - Vector3.new(0, 3.5, 0) 
                            
                            local finished = false
                            local moveConn = RunService.Heartbeat:Connect(function(dt)
                                if not IsFarming or not Root or not Root.Parent then finished = true return end
                                local offset = targetPos - Root.Position
                                local distance = offset.Magnitude
                                if distance < 0.5 then
                                    finished = true
                                    return
                                end
                                
                                local safeDt = math.min(dt, 0.5)
                                local step = math.min(TweenSpeed * safeDt, distance)
                                local nextPosition = Root.Position + offset.Unit * step
                                
                                -- Force the laying flat pose
                                local flatOffset = Vector3.new(offset.X, 0, offset.Z)
                                if flatOffset.Magnitude > 0.05 then
                                    Root.CFrame = CFrame.lookAt(nextPosition, nextPosition + flatOffset.Unit) * CFrame.Angles(-math.pi / 2, 0, 0)
                                else
                                    Root.CFrame = CFrame.new(nextPosition) * CFrame.Angles(-math.pi / 2, 0, 0)
                                end
                            end)
                            
                            local startWait = tick()
                            while not finished and tick() - startWait < (D / TweenSpeed) + 1 do
                                if not IsFarming or not GetParts() then break end 
                                task.wait(0.05)
                            end
                            
                            if moveConn then moveConn:Disconnect() end

                            if GetParts() and Target.Parent then
                                CandyCollected += 1
                                CandyLabel.Text = "Candy Collected: " .. tostring(CandyCollected)
                                local Elapsed = os.time() - StartTime
                                if Elapsed > 0 then RateLabel.Text = "Est. Candy/Hour: " .. tostring(math.floor((CandyCollected / Elapsed) * 3600)) end
                            end
                        else
                            RateLabel.Text = "In Lobby - Waiting for match..."
                            RateLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                            task.wait(1)
                        end
                    else
                        RateLabel.Text = "Match End - Waiting for next round..."
                        RateLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                        task.wait(1)
                    end
                end
            end)
            task.wait(0.1)
        end
    end)
end

function StopFarming() 
    IsFarming = false
    if currentMurdererHighlight then currentMurdererHighlight:Destroy() currentMurdererHighlight = nil end
    if FarmingThread then FarmingThread = nil end
    
    -- Restore character state
    local Root, Hum = GetParts()
    if Root and Hum then
        Hum.PlatformStand = false
        if OriginalNameDisplay then
            Hum.DisplayDistanceType = OriginalNameDisplay
        end
        for part, _ in pairs(CollisionCache) do
            if part and part.Parent then
                part.CanCollide = true
            end
        end
        table.clear(CollisionCache)
    end
end
